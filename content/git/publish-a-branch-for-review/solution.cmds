# Reference solution. One command, and the flag that makes the next five
# shorter.

git log --oneline --all
git status

# No upstream yet, so git has nothing to compare against -- note that status
# says nothing about being ahead of or up to date with anything.
git branch -vv

# -u records origin/feature/csv-upload as this branch's upstream, so later
# `git push`, `git pull` and `git status` all know where it belongs.
git push -u origin feature/csv-upload

git branch -vv
git status
git log --oneline --all
