# Reference solution. The merge stopping is not the problem -- it is git
# telling you that this is a decision only you can make.

git log --oneline --graph --all
git status
cat settings.ini

# Conflicts, and exits non-zero. Everything after this point is the answer.
git merge feature/tune

# What is unmerged, and what both sides wanted.
git status
cat settings.ini
git diff

# Resolve by hand: the branch's measured worker count AND main's timeout.
write settings.ini '[server]' 'host = 0.0.0.0' 'port = 8080' 'workers = 8' 'timeout_seconds = 30'

# Staging the file is how you tell git the conflict is resolved.
git add settings.ini
git status

git commit

git log --oneline --graph --all
cat settings.ini
git status
