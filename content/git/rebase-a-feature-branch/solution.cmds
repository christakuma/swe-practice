# Reference solution. Replay the branch's own commits on top of the new main,
# which is what makes the eventual merge a fast-forward.

git log --oneline --all
git status

# Exactly which commits are mine and not on main yet.
git log --oneline main..feature/report

# Rebase moves the branch you are ON, so stand on it first.
git checkout feature/report
git rebase main

git log --oneline --all
git status
cat report.py
