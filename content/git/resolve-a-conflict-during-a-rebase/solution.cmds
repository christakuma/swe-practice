# Reference solution. A rebase replays commits one at a time and stops at the
# first one that will not apply. Resolve, commit, continue.

git log --oneline --graph --decorate --all
cat retry.py

git checkout feature/backoff

# Stops on f1, which touched the same block main did. Exits non-zero.
git rebase main

git status --short
cat retry.py

# Keep the branch's five attempts and its backoff, and main's gateway-error
# list and the condition that uses it.
write retry.py '"""Retry policy for delivery callbacks."""' '' '' 'MAX_ATTEMPTS = 5' 'RETRY_ON = (500, 502, 503, 504)' '' '' 'def backoff_seconds(attempt):' '    """Wait longer after each failure."""' '    return 2 ** attempt' '' '' 'def should_retry(status, attempt):' '    """Whether to try again after this response."""' '    return status in RETRY_ON and attempt in range(MAX_ATTEMPTS)'

git add retry.py

# Commit the resolution with the original message, then let the rebase carry
# on to f2 -- which applies cleanly, because it touches a different file.
git commit --no-edit
git rebase --continue

git log --oneline --graph --decorate --all
cat retry.py
cat jitter.py
git status --short --branch
