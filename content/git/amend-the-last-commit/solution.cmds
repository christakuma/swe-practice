# Reference solution. Look first, then fix the file and the message together in
# the commit that is already there.

git log --oneline --decorate --all
git status --short --branch
git show --stat HEAD
cat metrics.py

# The same file with the debug line gone.
write metrics.py '"""Summary statistics for a list of numbers."""' '' '' 'def average(values):' '    """The arithmetic mean."""' '    return sum(values) / len(values)' '' '' 'def median(values):' '    """The middle value, averaging the two middle ones when even."""' '    ordered = sorted(values)' '    middle = len(ordered) // 2' '    if len(ordered) % 2 == 1:' '        return ordered[middle]' '    return (ordered[middle - 1] + ordered[middle]) / 2'

git add metrics.py
git commit --amend -m "Add median"

# Verify: still three commits, origin still one behind.
git log --oneline --decorate --all
cat metrics.py
