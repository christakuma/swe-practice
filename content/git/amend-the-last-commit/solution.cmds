# Reference solution. Look first, then take the scratch file out and fix the
# message together, in the commit that is already there.

git log --oneline --decorate --all
git status --short --branch
git show --stat HEAD
cat scratch.py

# Removes it from the working tree *and* stages the removal. The second half is
# the one that matters: amend builds the new commit from the index.
git rm scratch.py
git commit --amend -m "Add median"

# Verify: still three commits, origin still one behind, one file in the tip.
git log --oneline --decorate --all
git show --stat HEAD
