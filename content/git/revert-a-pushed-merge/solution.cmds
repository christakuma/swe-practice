# Reference solution. The merge is published, so it cannot be unmade -- only
# undone by a new commit that inverts it.

git log --oneline --graph --all
git status

# The merge commit has two parents -- show lists them on its "Merge:" line,
# first parent first. -m says which side to keep.
git show --stat HEAD

# -m 1 means "keep the first parent's line of history", which is main, and
# undo everything the second parent brought in.
git revert -m 1 HEAD

git log --oneline --graph --all
cat pricing.py
ls

# Publish the backout. A revert nobody can pull has not fixed production.
git push origin main
git status
